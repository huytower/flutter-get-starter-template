# Slack Incoming Webhook for crash reports (#crash) & user feedback (#user_feedback)
SLACK_CRASH_WEBHOOK_URL="YOUR_SLACK_CRASH_WEBHOOK_URL_HERE"
SLACK_FEEDBACK_WEBHOOK_URL="YOUR_SLACK_FEEDBACK_WEBHOOK_URL_HERE"
SLACK_WEBHOOK_URL="YOUR_SLACK_CRASH_WEBHOOK_URL_HERE"

# AI / Gemini Configuration
GEMINI_MODEL_NAME=gemini-3.8-flash
