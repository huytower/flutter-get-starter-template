# App Configuration
APP_NAME='So Sach Xin'

# API Configuration
API_URL=https://api-dev.example.com

# Feature Flags
ENABLE_LOGGER=true
ENABLE_LOGGER_DIO=true
ENABLE_CRASH_LOG_UPLOAD=true
ENABLE_DEV_CRASH_LOG_VIEWER=false
ENABLE_VIP_MODE=false

# Slack Incoming Webhook for crash reports (#crash) & user feedback (#user_feedback)
SLACK_CRASH_WEBHOOK_URL="YOUR_SLACK_CRASH_WEBHOOK_URL_HERE"
SLACK_FEEDBACK_WEBHOOK_URL="YOUR_SLACK_FEEDBACK_WEBHOOK_URL_HERE"
SLACK_WEBHOOK_URL="YOUR_SLACK_CRASH_WEBHOOK_URL_HERE"

# AI / Gemini Configuration
GEMINI_MODEL_NAME="YOUR_GEMINI_MODEL_NAME_HERE"

# App update (force update) - DEFAULTS ONLY. The live values are the Firebase
# Remote Config keys isForce / minimumOsVersionHasForce; these apply before the
# first fetch, offline, or when a key is missing there.
# IS_FORCE_UPDATE: off unless exactly "true".
# MINIMUM_OS_VERSION_HAS_FORCE: semver app version (e.g. 1.2.0); installed
# versions below it are blocked until updated.
IS_FORCE_UPDATE="YOUR_IS_FORCE_UPDATE_HERE"
MINIMUM_OS_VERSION_HAS_FORCE="YOUR_MINIMUM_OS_VERSION_HAS_FORCE_HERE"
