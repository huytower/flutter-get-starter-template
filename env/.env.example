# .env.example - Duplicate this file to .env.uat or .env.prod

# App Configuration
APP_NAME='MyApp (Example)'

# API Configuration
API_URL=https://api-dev.example.com

# Routing Configuration
MAIN_NAVIGATION_PATH=/main_navigation
LOGIN_PATH=/login

# Feature Flags
ENABLE_LOGGER=true
ENABLE_LOGGER_DIO=true
ENABLE_CRASH_LOG_UPLOAD=true
CRASH_LOG_API_PATH=/client-logs
ENABLE_DEV_CRASH_LOG_VIEWER=false
ENABLE_QA_DEBUG_TOOLS=true

# Firebase/Google Configuration
GOOGLE_API_KEY_ANDROID="YOUR_ANDROID_KEY_HERE"
GOOGLE_API_KEY_IOS="YOUR_IOS_KEY_HERE"
FIREBASE_PROJECT_ID="your-project-id"
