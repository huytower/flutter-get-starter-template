"NSCameraUsageDescription" = "Sổ Sách Xịn cần truy cập máy ảnh để chụp ảnh biên lai và hóa đơn, giúp tự động ghi chép giao dịch và lưu trữ minh chứng.";
"NSDocumentsFolderUsageDescription" = "Sổ Sách Xịn cần truy cập thư mục tài liệu để lưu và xuất các báo cáo tài chính cũng như dữ liệu giao dịch của bạn.";
"NSFaceIDUsageDescription" = "Sổ Sách Xịn sử dụng Face ID để xác thực tài khoản an toàn và bảo vệ dữ liệu tài chính của bạn khỏi truy cập trái phép.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Sổ Sách Xịn sử dụng vị trí của bạn để tự động nhận diện mã quốc gia và gợi ý chi tiêu thông minh dựa trên các cửa hàng lân cận (tính năng tùy chọn).";
"NSLocationWhenInUseUsageDescription" = "Sổ Sách Xịn sử dụng vị trí của bạn để tự động nhận diện mã quốc gia và gợi ý chi tiêu thông minh dựa trên các cửa hàng lân cận (tính năng tùy chọn).";
"NSMicrophoneUsageDescription" = "Sổ Sách Xịn sử dụng micro để bạn có thể nhập nhanh giao dịch bằng giọng nói, ví dụ: \"50k cà phê\" (tính năng tùy chọn).";
"NSPhotoLibraryAddUsageDescription" = "Sổ Sách Xịn cần quyền lưu ảnh biên lai và ảnh giao dịch vào thư viện ảnh để bạn tiện theo dõi và lưu trữ.";
"NSPhotoLibraryUsageDescription" = "Sổ Sách Xịn cần truy cập thư viện ảnh để đính kèm ảnh biên lai vào giao dịch và nhập ảnh hóa đơn để tự động xử lý dữ liệu.";
"NSSpeechRecognitionUsageDescription" = "Sổ Sách Xịn sử dụng tính năng nhận dạng giọng nói trên thiết bị để chuyển giọng nói của bạn thành văn bản giúp nhập liệu nhanh (tính năng tùy chọn).";
"NSUserTrackingUsageDescription" = "Sổ Sách Xịn thu thập báo cáo lỗi và dữ liệu hiệu suất để cải thiện độ ổn định của ứng dụng và tìm lỗi. Danh tính của bạn luôn được bảo mật.";
