<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest for the Runner target. Keep in step with
  docs/STORE_PRIVACY_LABELS.md and assets/legal/privacy_policy.html.
  Plugins and Flutter ship their own manifests for the required-reason APIs
  they use; the Runner's own code uses none, so NSPrivacyAccessedAPITypes is empty.
-->
