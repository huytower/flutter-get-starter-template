default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    flavor = options[:flavor] || "prod"

    # 1. Generate code (run from root directory)
    # Use direct Flutter command instead of melos to avoid PATH issues
    sh("cd ../.. && melos run gen")

    # 2. Setup API Key (handles raw .p8 text or base64, normalizes escapes & linebreaks)
    raw_content = (ENV["APP_STORE_CONNECT_KEY_CONTENT"] || "").strip
    if raw_content.start_with?("-----BEGIN")
      key_pem = raw_content
    else
      require "base64"
      begin
        key_pem = Base64.decode64(raw_content)
      rescue => e
        key_pem = raw_content
      end
    end
    key_pem = key_pem.gsub("\r", "").gsub("\\n", "\n").strip

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_pem,
      is_key_content_base64: false
    )

    # 3. Prepare Flutter artifacts
    # Prepares the ios/ folder and compiled Dart code
    sh("cd ../.. && flutter build ios --release --flavor #{flavor} --no-codesign")

    # 4. Build App (Gym)
    build_app(
      scheme: flavor,
      workspace: "Runner.xcworkspace",
      include_bitcode: false,
      export_method: "app-store",
      api_key: api_key,
      output_directory: "../../build/ios/ipa",
      output_name: "Runner.ipa"
    )

    # 5. Upload to TestFlight (Pilot)
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
