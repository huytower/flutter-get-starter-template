default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    flavor = options[:flavor] || "prod"

    # 1. Generate code (run from root directory)
    # Use direct Flutter command instead of melos to avoid PATH issues
    sh("cd ../.. && melos run gen")

    # 2. Setup API Key (to bypass 2FA)
    raw_content = (ENV["APP_STORE_CONNECT_KEY_CONTENT"] || "").strip
    key_id = (ENV["APP_STORE_CONNECT_KEY_ID"] || "").strip
    issuer_id = (ENV["APP_STORE_CONNECT_ISSUER_ID"] || "").strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID is missing or empty!") if key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is missing or empty!") if issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT is missing or empty! Please configure the secret in GitHub.") if raw_content.empty?

    # Strip surrounding quotes if the secret was wrapped in quotes
    raw_content = raw_content.sub(/\A['"]/, "").sub(/['"]\z/, "").strip

    # Normalize carriage returns and literal escaped newlines
    normalized = raw_content.gsub("\r", "").gsub("\\n", "\n").strip

    # Accept PEM, base64-encoded PEM, or base64-encoded DER without ever
    # wrapping the encoded text itself as a private key.
    unless normalized.include?("BEGIN")
      require "base64"
      encoded_content = normalized.gsub(/\s+/, "")
      begin
        decoded_content = Base64.strict_decode64(encoded_content)
        normalized = if decoded_content.include?("BEGIN")
          decoded_content.strip
        else
          der_body = Base64.strict_encode64(decoded_content).scan(/.{1,64}/).join("\n")
          "-----BEGIN PRIVATE KEY-----\n#{der_body}\n-----END PRIVATE KEY-----"
        end
      rescue ArgumentError
        UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT must be PEM or valid base64-encoded PEM/DER")
      end
    end

    # Format into clean PEM string while preserving the key type header.
    if normalized =~ /-----BEGIN ([^-]+)-----\s*([\s\S]+?)\s*-----END \1-----/
      pem_type = $1
      body = $2.gsub(/\s+/, "")
      wrapped_body = body.scan(/.{1,64}/).join("\n")
      pem_content = "-----BEGIN #{pem_type}-----\n#{wrapped_body}\n-----END #{pem_type}-----\n"
    else
      pem_content = "#{normalized}\n"
    end

    # Fastlane 2.241.x parses App Store Connect keys as SEC1 EC keys. Apple
    # downloads PKCS#8 keys, so convert that format before handing it to
    # Spaceship. Keep SEC1 keys unchanged.
    if pem_content.include?("BEGIN PRIVATE KEY")
      require "open3"
      conversion_commands = [
        ["openssl", "pkcs8", "-inform", "PEM", "-outform", "PEM", "-traditional", "-nocrypt"],
        ["openssl", "pkey", "-inform", "PEM", "-outform", "PEM", "-traditional"]
      ]
      converted_key = nil
      conversion_error = nil

      conversion_commands.each do |command|
        output, error, status = Open3.capture3(*command, stdin_data: pem_content)
        if status.success? && output.include?("BEGIN EC PRIVATE KEY")
          converted_key = output
          break
        end
        conversion_error = error
      end

      if converted_key.nil?
        UI.user_error!(
          "Unable to parse APP_STORE_CONNECT_KEY_CONTENT as an Apple App Store Connect EC key. " \
          "Regenerate the App Store Connect .p8 key and store its original PEM or base64 content. " \
          "OpenSSL: #{conversion_error.to_s.strip}"
        )
      end
      pem_content = converted_key
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: begin
        require "tmpdir"
        key_file = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
        File.write(key_file, pem_content)
        key_file
      end
    )

    # 3. Prepare Flutter artifacts
    # Prepares the ios/ folder and compiled Dart code
    sh("flutter config --no-enable-swift-package-manager && cd ../.. && flutter pub get && cd ios && bundle exec pod install && cd .. && flutter build ios --release --flavor #{flavor} --no-codesign --no-tree-shake-icons")

    # 3.1 Import Certificate if provided in environment
    if ENV["APPLE_CERTIFICATE_BASE64"] && !ENV["APPLE_CERTIFICATE_BASE64"].empty?
      keychain_name = "build.keychain"
      keychain_password = "keychain_password"
      p12_path = File.join(Dir.tmpdir, "dist_cert.p12")

      require "base64"
      File.binwrite(p12_path, Base64.decode64(ENV["APPLE_CERTIFICATE_BASE64"].strip))

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["APPLE_CERTIFICATE_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    end

    # 3.2 Download App Store Provisioning Profile
    get_provisioning_profile(
      app_identifier: "vn.sosachxin.finance",
      api_key: api_key,
      readonly: true
    )

    # 4. Build App (Gym)
    build_app(
      scheme: flavor,
      workspace: "Runner.xcworkspace",
      include_bitcode: false,
      export_method: "app-store",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "46KM345YTJ"
      },
      output_directory: "../../build/ios/ipa",
      output_name: "Runner.ipa"
    )

    # 5. Upload to TestFlight (Pilot)
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
