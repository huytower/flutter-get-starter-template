default_platform(:ios)

require "shellwords"
require "tmpdir"

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    flavor = options[:flavor] || "prod"

    # 1. Generate code (run from root directory).
    # CI already ran `melos run gen` and sets SKIP_GEN=true to avoid repeating it.
    sh("cd ../.. && melos run gen") unless ENV["SKIP_GEN"] == "true"

    # 2. Setup API Key (to bypass 2FA)
    raw_content = (ENV["APP_STORE_CONNECT_KEY_CONTENT"] || "").strip
    key_id = (ENV["APP_STORE_CONNECT_KEY_ID"] || "").strip
    issuer_id = (ENV["APP_STORE_CONNECT_ISSUER_ID"] || "").strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID is missing or empty!") if key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is missing or empty!") if issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT is missing or empty! Please configure the secret in GitHub.") if raw_content.empty?

    # Strip surrounding quotes if the secret was wrapped in quotes
    raw_content = raw_content.sub(/\A['"]/, "").sub(/['"]\z/, "").strip

    # Normalize carriage returns and literal escaped newlines
    normalized = raw_content.gsub("\r", "").gsub("\\n", "\n").strip

    # Accept PEM, base64-encoded PEM, or base64-encoded DER without ever
    # wrapping the encoded text itself as a private key.
    unless normalized.include?("BEGIN")
      require "base64"
      encoded_content = normalized.gsub(/\s+/, "")
      begin
        decoded_content = Base64.strict_decode64(encoded_content)
        normalized = if decoded_content.include?("BEGIN")
          decoded_content.strip
        else
          der_body = Base64.strict_encode64(decoded_content).scan(/.{1,64}/).join("\n")
          "-----BEGIN PRIVATE KEY-----\n#{der_body}\n-----END PRIVATE KEY-----"
        end
      rescue ArgumentError
        UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT must be PEM or valid base64-encoded PEM/DER")
      end
    end

    # Format into clean PEM string
    if normalized =~ /-----BEGIN ([^-]+)-----\s*([\s\S]+?)\s*-----END \1-----/
      pem_type = $1
      body = $2.gsub(/\s+/, "")
      wrapped_body = body.scan(/.{1,64}/).join("\n")
      pem_content = "-----BEGIN #{pem_type}-----\n#{wrapped_body}\n-----END #{pem_type}-----\n"
    else
      pem_content = "#{normalized.strip}\n"
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: pem_content
    )

    # 3. Fetch latest build number from TestFlight to increment automatically
    # Fail fast if App Store Connect cannot be queried. Falling back to the CI run
    # number here would silently pick a number lower than what is already on
    # TestFlight and only fail after the (long) build, at upload time.
    latest_build = begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "vn.sosachxin.finance"
      ) || 0
    rescue => e
      UI.user_error!("Could not read the latest TestFlight build number: #{e.message}")
    end

    next_build_number = latest_build > 0 ? latest_build + 1 : (ENV["BUILD_NUMBER"] || 1).to_i

    # 3. Prepare Flutter artifacts
    # Prepares the ios/ folder and compiled Dart code
    sh("flutter config --no-enable-swift-package-manager && cd ../.. && flutter pub get && cd ios && bundle exec pod install && cd .. && flutter build ios --release --flavor #{flavor} --build-number=#{next_build_number} --no-codesign --no-tree-shake-icons")

    # 3.1 Import Certificate if provided in environment
    if ENV["APPLE_CERTIFICATE_BASE64"] && !ENV["APPLE_CERTIFICATE_BASE64"].empty?
      keychain_name = "build.keychain"
      keychain_password = "keychain_password"
      p12_path = File.join(Dir.tmpdir, "dist_cert.p12")

      require "base64"
      File.binwrite(p12_path, Base64.decode64(ENV["APPLE_CERTIFICATE_BASE64"].strip))

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["APPLE_CERTIFICATE_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      # Sanity check only: the p12 must contain an Apple Distribution identity.
      # Do NOT pass this SHA-1 to get_provisioning_profile as `cert_id` — that
      # parameter is the App Store Connect certificate ID (e.g. "7X37QM43YW"),
      # not the local fingerprint, so no profile would ever match. Without
      # `cert_id`, sigh matches profiles against the identities installed locally.
      identities = `security find-identity -v -p codesigning 2>/dev/null`
      unless identities.include?("Apple Distribution:")
        UI.user_error!("The imported certificate is not an Apple Distribution certificate")
      end
    end

    # 3.2 Clear old provisioning profile cache and download fresh profile from Apple
    sh("rm -rf ~/Library/MobileDevice/Provisioning\\ Profiles/* || true")
    sh("rm -rf ~/Library/Developer/Xcode/DerivedData/* || true")

    # Entitlements the release app declares (Sign in with Apple, push, App Attest,
    # app groups...). Every one of them must ALSO be present in the provisioning
    # profile, otherwise the capability silently does not work at runtime even
    # though build, archive and TestFlight upload all succeed. This happens when the
    # profile was generated before the capability was enabled on the App ID.
    entitlements_file = File.expand_path("../Runner/RunnerRelease.entitlements", Dir.pwd)
    UI.user_error!("Entitlements file not found: #{entitlements_file}") unless File.exist?(entitlements_file)

    entitlement_gaps = lambda do |granted|
      required = Plist.parse_xml(File.read(entitlements_file)) || {}
      required.each_with_object([]) do |(key, value), gaps|
        have = granted[key]
        missing = if have.nil?
          true
        elsif value.is_a?(Array) && have.is_a?(Array)
          !(value - have).empty?
        else
          false
        end
        gaps << key if missing
      end
    end

    profile_entitlements = lambda do |path|
      Plist.parse_xml(`security cms -D -i #{Shellwords.escape(path)}`)["Entitlements"] || {}
    end

    # `force: false` reuses a valid profile bound to the installed certificate (no
    # pile of "AppStore <timestamp>" profiles); `force: true` creates a fresh one
    # from the App ID's *current* capabilities.
    fetch_profile = lambda do |force|
      get_provisioning_profile(
        app_identifier: "vn.sosachxin.finance",
        api_key: api_key,
        force: force,
        skip_certificate_verification: false
      )
      Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
    end

    profile_path = fetch_profile.call(false)
    gaps = begin
      entitlement_gaps.call(profile_entitlements.call(profile_path))
    rescue => e
      UI.important("Could not inspect the profile's entitlements (#{e.message}); skipping this check.")
      []
    end

    unless gaps.empty?
      UI.important("Provisioning profile is missing #{gaps.join(', ')} (stale profile?). Regenerating it from the App ID.")
      profile_path = fetch_profile.call(true)
      gaps = entitlement_gaps.call(profile_entitlements.call(profile_path))
      unless gaps.empty?
        UI.user_error!(
          "The App ID does not grant #{gaps.join(', ')} to a newly generated profile. " \
          "Enable the capability on the App ID in the Apple Developer portal, then re-run."
        )
      end
    end

    profile_uuid = Actions.lane_context[SharedValues::SIGH_UUID]
    profile_name = Actions.lane_context[SharedValues::SIGH_NAME]

    if profile_path && profile_uuid
      target_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      sh("mkdir -p '#{target_dir}'")
      sh("cp '#{profile_path}' '#{target_dir}/#{profile_uuid}.mobileprovision'")
      UI.message("Successfully installed provisioning profile #{profile_uuid}.mobileprovision")
    end

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "46KM345YTJ",
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"],
      build_configurations: ["Release-prod"]
    )

    # 4. Build App (Gym)
    build_app(
      scheme: flavor,
      workspace: "Runner.xcworkspace",
      configuration: "Release-prod",
      include_bitcode: false,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "46KM345YTJ",
        provisioningProfiles: {
          "vn.sosachxin.finance" => profile_name
        }
      },
      output_directory: "../../build/ios/ipa",
      output_name: "Runner.ipa"
    )

    # 4.1 Verify the signed IPA really carries the entitlements before uploading, so
    # a build with a broken capability never reaches TestFlight.
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    signed_entitlements = begin
      Dir.mktmpdir do |dir|
        system("unzip", "-q", ipa_path, "-d", dir) || raise("unzip failed")
        app = Dir.glob(File.join(dir, "Payload", "*.app")).first || raise("no .app inside the IPA")
        Plist.parse_xml(`codesign -d --entitlements :- #{Shellwords.escape(app)} 2>/dev/null`) ||
          raise("no entitlements found")
      end
    rescue => e
      UI.important("Could not read the IPA's signed entitlements (#{e.message}); skipping this check.")
      nil
    end

    if signed_entitlements
      gaps = entitlement_gaps.call(signed_entitlements)
      UI.user_error!("The signed IPA is missing entitlements: #{gaps.join(', ')}") unless gaps.empty?
      UI.success("Signed IPA carries all required entitlements (#{signed_entitlements.keys.join(', ')})")
    end

    # 5. Upload to TestFlight (Pilot)
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
