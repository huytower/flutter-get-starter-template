default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    flavor = options[:flavor] || "prod"

    # 1. Generate code (run from root directory)
    # Use direct Flutter command instead of melos to avoid PATH issues
    sh("cd ../.. && melos run gen")

    # 2. Setup API Key (to bypass 2FA)
    raw_content = (ENV["APP_STORE_CONNECT_KEY_CONTENT"] || "").strip
    key_id = (ENV["APP_STORE_CONNECT_KEY_ID"] || "").strip
    issuer_id = (ENV["APP_STORE_CONNECT_ISSUER_ID"] || "").strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID is missing or empty!") if key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is missing or empty!") if issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT is missing or empty! Please configure the secret in GitHub.") if raw_content.empty?

    # Strip surrounding quotes if the secret was wrapped in quotes
    raw_content = raw_content.sub(/\A['"]/, "").sub(/['"]\z/, "").strip

    # If the content doesn't have the PEM header, it may be base64-encoded
    if !raw_content.include?("BEGIN")
      require "base64"
      begin
        decoded = Base64.decode64(raw_content).strip
        if decoded.include?("BEGIN")
          raw_content = decoded
        else
          # In case the secret only contains the raw base64 DER body
          raw_content = "-----BEGIN PRIVATE KEY-----\n#{raw_content}\n-----END PRIVATE KEY-----"
        end
      rescue => e
        # Fall back to raw_content if decoding fails
      end
    end

    # Normalize carriage returns and literal escaped newlines
    normalized = raw_content.gsub("\r", "").gsub("\\n", "\n").strip

    # Extract base64 body and format into RFC-compliant 64-character lines
    if normalized =~ /-----BEGIN[^-]+-----\s*([\s\S]+?)\s*-----END[^-]+-----/
      body = $1.gsub(/\s+/, "") # Remove all whitespace/newlines from body
      wrapped_body = body.scan(/.{1,64}/).join("\n")
      pem_content = "-----BEGIN PRIVATE KEY-----\n#{wrapped_body}\n-----END PRIVATE KEY-----\n"
    else
      pem_content = "#{normalized}\n"
    end

    # Convert PKCS#8 (BEGIN PRIVATE KEY) to SEC1 (BEGIN EC PRIVATE KEY)
    # In Ruby 3.2+ / OpenSSL 3.x, OpenSSL::PKey::EC.new (used by Fastlane Spaceship) strictly
    # requires the SEC1 format (BEGIN EC PRIVATE KEY) to avoid 'invalid curve name (OpenSSL::PKey::ECError)'.
    require "openssl"
    begin
      pkey = OpenSSL::PKey.read(pem_content)
      begin
        ec = OpenSSL::PKey::EC.new(pkey.to_der)
        pem_content = ec.to_pem
      rescue => e
        require "open3"
        stdout, stderr, status = Open3.capture3("openssl ec", stdin_data: pem_content)
        pem_content = stdout if status.success? && !stdout.to_s.strip.empty?
      end
    rescue => e
      require "open3"
      stdout, stderr, status = Open3.capture3("openssl ec", stdin_data: pem_content)
      pem_content = stdout if status.success? && !stdout.to_s.strip.empty?
    end

    # Ensure trailing newline
    pem_content = "#{pem_content.strip}\n"

    # Write key to temporary .p8 file for Fastlane key_filepath
    require "tmpdir"
    key_file = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_file, pem_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_file
    )

    # 3. Prepare Flutter artifacts
    # Prepares the ios/ folder and compiled Dart code
    sh("cd ../.. && flutter build ios --release --flavor #{flavor} --no-codesign")

    # 4. Build App (Gym)
    build_app(
      scheme: flavor,
      workspace: "Runner.xcworkspace",
      include_bitcode: false,
      export_method: "app-store",
      api_key: api_key,
      output_directory: "../../build/ios/ipa",
      output_name: "Runner.ipa"
    )

    # 5. Upload to TestFlight (Pilot)
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
