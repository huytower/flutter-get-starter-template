default_platform(:android)

platform :android do
  desc "Build AAB and upload to Google Play Console Alpha track"
  lane :build_release do |options|
    flavor = options[:flavor] || "prod"

    # 1. Generate code (run from root directory).
    sh("cd ../.. && melos run gen") unless ENV["SKIP_GEN"] == "true"

    build_num = [25 + (ENV["BUILD_NUMBER"] || "1").to_i, 26].max
    ENV["BUILD_NUMBER"] = build_num.to_s

    # 2. Build the Flutter App Bundle
    sh("cd ../.. && flutter build appbundle --release --flavor #{flavor} --build-number=#{build_num} --no-tree-shake-icons")

    # 3. Upload AAB to Google Play Console.
    # Missing credentials must fail the job; silently skipping would report a
    # green build while nothing reached Play.
    credentials = (ENV["FIREBASE_SERVICE_CREDENTIALS"] || "").strip
    UI.user_error!("FIREBASE_SERVICE_CREDENTIALS is missing or empty; cannot upload to Google Play.") if credentials.empty?

    upload_to_play_store(
      track: "alpha",
      package_name: "vn.sosachxin.finance",
      aab: File.expand_path("../../build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab", __dir__),
      json_key_data: credentials,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
